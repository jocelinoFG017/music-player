# Cache e arquivos compilados do Python
__pycache__/
*.py[cod]

# Ambientes virtuais
.venv/
venv/

# Artefatos de empacotamento
*.egg-info/
build/
dist/

# Músicas adicionadas pelo usuário
music/*
!music/.gitkeep

# Arquivos baixados pelo programa
download-direto/*
!download-direto/.gitkeep

# Arquivos temporários criados ao atualizar o yt-dlp
.tools/yt-dlp.novo
.tools/.atualizacao-yt-dlp-*/
